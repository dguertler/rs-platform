# Financial Modeling Prep API Key
# Kostenlos registrieren: https://financialmodelingprep.com/developer/docs
# Wird für die Nasdaq-100 / S&P 500 Ticker-Liste genutzt (immer aktuell).
# Ohne Key: Fallback auf Wikipedia (leicht verzögert bei Indexänderungen).
FMP_API_KEY=

DATA_DIR=/path/to/rs-data
SECRET_KEY=change-me-use-openssl-rand-hex-32
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
APP_URL=http://localhost:8000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=RS Platform <noreply@example.com>

# ── Telegram-Benachrichtigungen ───────────────────────────────────────────────
# Bot-Token von @BotFather. Im Backend werden auch TELEGRAM_BOT_TOKEN /
# BOT_TOKEN / TG_BOT_TOKEN als Namen akzeptiert. Der Bot-Username wird
# automatisch via getMe ermittelt – kein separates Secret nötig.
TELEGRAM_TOKEN=123456:ABC-DEF...
# Standard-Empfänger (Admin). Mehrere möglich, kommagetrennt: 111,222,@kanal
TELEGRAM_CHAT_ID=
# Geteiltes Geheimnis: schützt /api/telegram/recipients UND dient als
# Telegram-Webhook-Secret. Gleicher Wert im Backend und in den
# GitHub-Actions-Secrets der Alert-Jobs.
ALERT_API_KEY=
# Optional: Basis-URL des Backends für den Empfänger-Abruf der Alert-Jobs.
# Wenn leer, wird FRONTEND_URL verwendet.
RS_API_URL=
# Frontend-/Backend-URL (gleiche Origin); Fallback für RS_API_URL.
# Der Telegram-Webhook wird auf APP_URL (oben) bzw. FRONTEND_URL registriert.
FRONTEND_URL=https://your-app.example.com
# Gültigkeit der Auto-Login-Tokens in den Telegram-Deep-Links (Stunden).
# Diese Tokens stehen im Chat — bewusst kürzer als die Session (Standard 72h).
MAGIC_LINK_EXPIRE_HOURS=72
