# Financial Modeling Prep API Key
# Kostenlos registrieren: https://financialmodelingprep.com/developer/docs
# Wird für die Nasdaq-100 / S&P 500 Ticker-Liste genutzt (immer aktuell).
# Ohne Key: Fallback auf Wikipedia (leicht verzögert bei Indexänderungen).
FMP_API_KEY=

DATA_DIR=/path/to/rs-data
SECRET_KEY=change-me-use-openssl-rand-hex-32
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
APP_URL=http://localhost:8000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=RS Platform <noreply@example.com>

# ── Telegram-Benachrichtigungen ───────────────────────────────────────────────
# Bot-Token von @BotFather
TELEGRAM_TOKEN=123456:ABC-DEF...
# Standard-Empfänger (Admin). Mehrere möglich, kommagetrennt: 111,222,@kanal
TELEGRAM_CHAT_ID=
# Bot-Benutzername ohne @ – für die Anleitung auf der Konto-Seite
TELEGRAM_BOT_USERNAME=
# Geteiltes Geheimnis: schützt /api/telegram/recipients. Gleicher Wert hier
# (Backend) und in den GitHub-Actions-Secrets der Alert-Jobs.
ALERT_API_KEY=
# Basis-URL des Backends – damit die Alert-Jobs die registrierten Empfänger
# abrufen können (nur in den GitHub-Actions-Workflows nötig).
RS_API_URL=https://your-backend.example.com
